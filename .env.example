VITE_API_BASE_URL=https://footballcinematicai-v10.onrender.com

# ---------------------------------------------------------------------------
# Gemini API keys — AUTOMATIC ROTATION POOL
# ---------------------------------------------------------------------------
# Comma (or newline/space) separated list. The server hands keys out in a fair
# round-robin; when a key hits a quota (429 / RESOURCE_EXHAUSTED) or an overload
# (503), it is put on cooldown and the SAME operation is retried on the next
# healthy key. Duplicated keys are de-duplicated automatically.
GEMINI_API_KEYS=

# Legacy single-key variable. Kept as an extra fallback so existing setups keep
# working; it is merged into the pool above.
GEMINI_API_KEY=

# Rotation tuning (all optional).
# GEMINI_QUOTA_COOLDOWN_MS=60000    # cooldown after a quota error (no retryDelay given)
# GEMINI_OVERLOAD_COOLDOWN_MS=12000 # cooldown after a transient overload
# GEMINI_MAX_COOLDOWN_MS=300000     # hard cap on any cooldown
# GEMINI_MAX_KEY_ATTEMPTS=4         # max key rotations per operation

# ---------------------------------------------------------------------------
# Storage / persistence (solves the Render ephemeral-filesystem blocker)
# ---------------------------------------------------------------------------
# STORAGE_DRIVER=local        # "local" (Render Disk / dev folder) | "s3"
# PUBLIC_DIR=public/videos    # Where /videos is served+written. Point this at
#                             # your Render Disk mount, e.g. /var/data/videos
# MEDIA_RETENTION_HOURS=0     # Auto-purge generated files older than N hours (0 = off)

# --- S3-compatible object storage (AWS S3 / Cloudflare R2 / MinIO) ---
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=football-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=https://cdn.example.com
# S3_FORCE_PATH_STYLE=false

# Gemini model used for actual video understanding
GEMINI_VIDEO_MODEL=gemini-3.8-flash

# Real Veo 3.1 cinematic inserts used by AI ENHANCED / AI CINEMATIC modes.
VEO_MODEL=veo-3.1-generate-preview
VEO_RESOLUTION=720p
VEO_MAX_POLLS=30

# Optional background music. If set, it is mixed quietly under the original match audio.
# MUSIC_PATH=/var/data/music/football_cinematic.mp3

# ---------------------------------------------------------------------------
# YOLOv8 football tracking
# ---------------------------------------------------------------------------
YOLO_ENABLED=true
YOLO_MODEL_PATH=/app/models/best.pt
PYTHON_BIN=python3

# ---------------------------------------------------------------------------
# ElevenLabs commentator — server-side only, never put these in the APK.
# Multiple keys are rotated automatically on 401/403/429/5xx.
# ---------------------------------------------------------------------------
ELEVENLABS_API_KEYS=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# RIFE frame interpolation
RIFE_ENABLED=true
RIFE_MODEL_DIR=/app/models/rife
RIFE_FPS_MULTIPLIER=2

# RIFE frame interpolation
RIFE_ENABLED=true
RIFE_REPO=/opt/rife
RIFE_FPS_MULTIPLIER=2

# ---------------------------------------------------------------------------
# Cinematic Engine (video_engine.py — OpenCV + NumPy, no FFmpeg, no MoviePy)
# ---------------------------------------------------------------------------
# OPT-IN. When true, the render pipeline runs an extra per-clip pre-pass that
# applies the CinematicEngine's smart slow-motion (optical-flow interpolation)
# to the short/clearly-slow shots the edit plan already marked as slow. Left
# OFF by default so production behaves exactly as before.
# It uses the SAME Python interpreter as the other helpers (PYTHON_BIN).
CINEMATIC_ENGINE_ENABLED=false

# ---------------------------------------------------------------------------
# OPTIONAL SAM 3.1 — segmentation + subject tracking (ENHANCEMENT, not a
# replacement). OFF by default. When false the render behaves EXACTLY as before.
# ---------------------------------------------------------------------------
# When true, an OPTIONAL pass runs BETWEEN the existing football analysis and the
# existing CinematicEngine, and ONLY on the interesting segments the edit plan
# already selected (shot/goal/dribble/tackle/save/celebration). It never runs on
# the whole video and never re-detects the ball — it consumes the existing YOLO
# tracking as prompts. Masks are stored as compact RLE/reference files, never
# inlined into the edit plan.
#
# Meta SAM 3.1 requires Python 3.12+ / PyTorch 2.7+ / CUDA 12.6+, which CONFLICT
# with the main pinned stack (torch 2.6.0+cpu, numpy<2, opencv-headless 4.10.0.84).
# Run SAM in its OWN isolated interpreter and point the server at it. The main
# environment is NEVER modified for SAM.
#
# Setup (does not touch the main venv):
#   python3.12 -m venv /opt/sam-venv
#   /opt/sam-venv/bin/pip install -r python/sam_requirements.txt
SAM_ENABLED=false
# Path to the ISOLATED Python interpreter that has the SAM deps installed.
# SAM_PYTHON_BIN=/opt/sam-venv/bin/python
# Local path to the SAM checkpoint (never downloaded from the network).
# SAM_MODEL_PATH=/opt/sam-models/sam3.1.pt
# auto (Meta SAM if importable, else graceful fallback) | meta (force) | mock (tests)
# SAM_ADAPTER=auto
# Compute device for the isolated interpreter: auto | cpu | cuda
# SAM_DEVICE=auto
# --- Bounded work (SAM never touches the whole video) ---
# SAM_STRIDE=4                    # sample every Nth frame inside a segment
# SAM_MAX_FRAMES_PER_SEGMENT=6    # hard cap of segmented frames per segment
# SAM_MAX_SEGMENTS=8              # hard cap of interesting segments per render
# SAM_MAX_OBJECTS_PER_SEGMENT=3   # max subjects segmented per segment
# SAM_DEADLINE_SECONDS=120        # wall-clock budget for the whole SAM pass
# SAM_TIMEOUT_MS=240000           # parent-side hard kill (never hangs the render)
# SAM_MASK_MODE=rle               # rle (compact) | png (keyframe preview) | none
# SAM_MASK_RESOLUTION=512         # masks are downscaled before compression
# SAM_CACHE_MAX_ENTRIES=500       # bounded mask cache (LRU-evicted)
# SAM_CACHE_DIR=/tmp/football_engine/work/sam_cache
